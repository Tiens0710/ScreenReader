<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FB7185">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#881337"
                        android:centerColor="#9F1239"
                        android:endColor="#BE123C"
                        android:type="linear" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#CCFB7185" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#6F102A"
                        android:centerColor="#881337"
                        android:endColor="#9F1239"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#80FB7185" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
