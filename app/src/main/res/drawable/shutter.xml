<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#405EEAD4">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Outer glow ring -->
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="2.5dp"
                        android:color="#B35EEAD4" />
                </shape>
            </item>
            <!-- Thin separator gap (simulated by inner oval fill) -->
            <item
                android:bottom="5dp"
                android:end="5dp"
                android:start="5dp"
                android:top="5dp">
                <shape android:shape="oval">
                    <solid android:color="#20FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#4DFFFFFF" />
                </shape>
            </item>
            <!-- Inner bright core -->
            <item
                android:bottom="10dp"
                android:end="10dp"
                android:start="10dp"
                android:top="10dp">
                <shape android:shape="oval">
                    <solid android:color="#F0FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
