<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#405EEAD4">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#134E48"
                        android:centerColor="#0F766E"
                        android:endColor="#047857"
                        android:type="linear" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#B35EEAD4" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#115E59"
                        android:centerColor="#0D9488"
                        android:endColor="#059669"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#805EEAD4" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
