<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Cosmic Dark Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#090E17"
                android:centerColor="#0F172A"
                android:endColor="#071E22"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ambient Top-Right Emerald/Teal Glow Orb -->
    <item
        android:bottom="300dp"
        android:left="100dp"
        android:right="-100dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="350dp"
                android:innerRadius="0dp"
                android:startColor="#330D9488"
                android:centerColor="#1A0D9488"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Ambient Mid-Left Indigo/Sapphire Glow Orb -->
    <item
        android:bottom="150dp"
        android:left="-120dp"
        android:right="120dp"
        android:top="220dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="320dp"
                android:innerRadius="0dp"
                android:startColor="#264F46E5"
                android:centerColor="#104F46E5"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Ambient Bottom-Right Cyan Glow -->
    <item
        android:bottom="-150dp"
        android:left="60dp"
        android:right="-80dp"
        android:top="450dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="300dp"
                android:innerRadius="0dp"
                android:startColor="#200284C7"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
