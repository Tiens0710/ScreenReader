<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card_interactive"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/langCheck"
        style="@style/ListItemLeadingIcon"
        android:src="@drawable/ic_check"
        app:tint="#5EEAD4" />

    <LinearLayout
        style="@style/ListItemTextGroup"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/langName"
            style="@style/ListItemLabel"
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/langStatus"
            style="@style/ListItemSupportingText"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/langAction"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:iconTint="#5EEAD4" />

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/langProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="24dp"
            app:indicatorColor="#2DD4BF" />
    </FrameLayout>
</LinearLayout>
